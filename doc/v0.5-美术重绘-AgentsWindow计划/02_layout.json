      { "r": 1, "c": 1, "id": "pistol_topdown" },
      { "r": 1, "c": 2, "id": "shotgun_topdown" }
    ]
  },
  "skill_sheet_layout": {
    "name": "Skills Grid 3x3",
    "cell": [256, 256],
    "cols": 3,
    "rows": 3,
    "cells": [
      { "r": 0, "c": 0, "id": "dash_ready" },
      { "r": 0, "c": 1, "id": "polar_slash_ready" },
